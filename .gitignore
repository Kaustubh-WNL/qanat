__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
.DS_Store
data/
*.duckdb
*.duckdb.wal
# `data/` above keeps generated stores out. The datasets qanat ships are not
# generated on the fly, and a clone without them cannot run the examples at all.
# The `.duckdb` rules above still apply inside these directories, so a store built
# by `qanat run` stays untracked.
!examples/fx-bundled/data/
!examples/fx-bundled/data/*.csv.gz
!examples/filings-sample/data/
!examples/filings-sample/data/*.csv.gz
.env

# Local IDE / agent config (machine-specific)
.claude/
.cursor/

# Demo video tooling (not part of the product)
videos/
node_modules/
package-lock.json
